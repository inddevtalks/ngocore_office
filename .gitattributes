# Windows checkouts should not rewrite every file as CRLF on disk.
* text=auto

*.py text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.css text eol=lf
*.json text eol=lf
*.html text eol=lf
*.md text eol=lf
*.yml text eol=lf

# Binary assets must never be line-ending converted.
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.woff binary
*.woff2 binary

# Windows scripts should keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf