SECRET_KEY=office-task-hub-secret-key-2026
DATABASE_URL=sqlite:///office_tasks.db
FRONTEND_URL=http://localhost:5173

# --- Email / SMTP Settings ---
# To send real emails via Gmail:
# 1. Go to your Google Account -> Security -> 2-Step Verification -> App passwords.
# 2. Generate a new App Password (name it "Office Hub").
# 3. Paste your Gmail address and 16-character App Password below.
# (If left empty, the app runs in Demo Outbox mode where all emails are previewable in the UI!)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM=your-email@gmail.com

# Daily email time in 24-hour format, server local time
DAILY_EMAIL_TIME=09:00
