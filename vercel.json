{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend/",
      "framework": "vite",
      "outputDirectory": "dist",
      "rewrites": [
        { "source": "/((?!assets/).*)", "destination": "/index.html" }
      ]
    },
    "api": {
      "root": "backend/",
      "entrypoint": "app:app",
      "framework": "flask",
      "functions": {
        "app.py": {
          "maxDuration": 120
        }
      }
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ],
  "crons": [
    {
      "path": "/api/cron/daily-emails",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/qa-check",
      "schedule": "30 6 * * *"
    },
    {
      "path": "/api/cron/security-check",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/due-reminders",
      "schedule": "30 12 * * *"
    }
  ]
}